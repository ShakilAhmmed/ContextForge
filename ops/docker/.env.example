ENV=local
DATABASE_URL=postgresql+asyncpg://contextforge:contextforge@postgres:5432/contextforge
JWT_SECRET=dev-secret-change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contextforge-documents
S3_REGION=us-east-1

# "mock" needs nothing else; "bedrock" isn't wired up yet (see app/core/embeddings.py)
EMBEDDING_PROVIDER=mock
QDRANT_COLLECTION=documents

# host ports nginx binds to (change if 8080/8443 are taken)
HTTP_PORT=8080
HTTPS_PORT=8443